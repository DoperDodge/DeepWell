; Engine configuration file.
; Project DEEPWELL — SCP Foundation survival horror.
; Released under CC BY-SA 3.0 — see LICENSE.md and docs/ATTRIBUTION.md.

config_version=5

[application]

config/name="Project DEEPWELL"
config/description="You are D-9341, a Class-D test subject in an SCP Foundation deep-storage site during a cascading containment failure. The only way out is down."
config/version="0.5.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
RNG="*res://src/autoload/rng.gd"
GameState="*res://src/autoload/game_state.gd"
TimeManager="*res://src/autoload/time_manager.gd"
FacilityState="*res://src/autoload/facility_state.gd"
LightProbe="*res://src/autoload/light_probe.gd"
Director="*res://src/autoload/director.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"device":-1)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"device":-1)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"device":-1)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"device":-1)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325,"device":-1)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67,"device":-1), Object(InputEventKey,"physical_keycode":4194326,"device":-1)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"device":-1)]
}
lean_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81,"device":-1)]
}
lean_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82,"device":-1)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69,"device":-1)]
}
flashlight={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70,"device":-1)]
}
blink={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":66,"device":-1)]
}
hold_eyes={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2,"device":-1)]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306,"device":-1), Object(InputEventKey,"physical_keycode":73,"device":-1)]
}
journal={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74,"device":-1)]
}
debug_overlay={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194334,"device":-1)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="door"
3d_physics/layer_5="scp"
3d_physics/layer_6="pickup"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.008, 0.008, 0.012, 1)
textures/default_filters/anisotropic_filtering_level=2
